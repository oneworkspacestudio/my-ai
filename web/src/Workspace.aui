Page Workspace variant=$theme
  Stack variant=rail
    Image src="./logo.svg" width=36 height=36 alt="My AI"
    For each=$rail
      Button action=navigate item=$item.action icon=$item.icon label=$item.label variant=$item.variant
    Spacer
    Button action=theme icon=SunMoon label="Change theme" variant=rail
    Button action=account icon=CircleUserRound label="Your account" variant=rail
  Stack variant=sidebar
    Row variant=brand
      Button action=surface icon=ChevronDown variant=surface "$surfaceLabel"
      Spacer
      Button action=search icon=Search label="Search sessions" variant=icon
      Button action=new icon=SquarePen label="New conversation" variant=icon
    If condition=$surfaceMenu
      Card variant=surface-menu
        Button action=chat icon=MessageSquare label="Chat" variant=menu
        Text "Explore ideas, ask anything"
        Button action=code icon=CodeXml label="Code" variant=menu
        Text "Build with your projects"
    Button action=new icon=Plus label="New conversation" variant=new
    Input name=search placeholder="Search conversations" variant=search
    Row variant=section-title
      Text "PROJECTS"
      Spacer
      Button action=projects icon=FolderPlus label="Manage projects" variant=icon
    For each=$groups
      Stack variant=project-group
        Button action=select-project item=$item.id icon=Folder label=$item.name variant=project
        For each=$item.sessions
          Button action=open item=$item.id label=$item.label variant=$item.variant
    Text variant=section-title "$sessionGroup"
    For each=$sessions
      Button action=open item=$item.id label=$item.label variant=$item.variant
    Spacer
    Row variant=sidebar-footer
      Text variant=dot "●"
      Text "$storageLabel"
      Spacer
      Button action=archives icon=Archive label="Show archived" variant=icon
  Stack variant=main
    Row variant=topbar
      Button action=mobile-menu icon=PanelLeft label="Toggle sidebar" variant=icon
      Icon name=$modeIcon size=18
      Text variant=title "$title"
      Spacer
      Button action=diff icon=GitCompareArrows label="Changes" disabled=$noProject variant=subtle
      Button action=session-menu icon=Ellipsis label="Conversation actions" variant=icon
      Button action=apps icon=Grid2X2 label="Apps" variant=icon
    If condition=$hasActiveDownloads
      Button action=models icon=Download variant=download-banner "$downloadSummary"
    Stack variant=conversation
      If condition=$empty
        Stack variant=welcome
          Card variant=welcome-icon
            Icon name=Sparkles size=34
          Text variant=eyebrow "YOUR SPACE TO THINK & BUILD"
          Heading level=1 "$welcomeTitle"
          Text "$welcomeDescription"
          Row variant=suggestions
            Button action=suggestion-chat icon=Lightbulb label="Explore an idea" variant=suggestion
            Button action=suggestion-code icon=CodeXml label="Build something" variant=suggestion
            Button action=models icon=Cpu label="Use a local model" variant=suggestion
      For each=$messages
        Card variant=$item.variant
          Row variant=message-heading
            Icon name=$item.icon size=18
            Text variant=author "$item.author"
            Spacer
            Text variant=muted "$item.model"
          Text variant=markdown "$item.content"
          For each=$item.attachments
            Row variant=attachment
              Icon name=Paperclip size=16
              Link href=$item.url "$item.name"
              Text variant=muted "$item.detail"
          If condition=$item.status
            Text variant=muted "$item.status"
      If condition=$streaming
        Card variant=assistant
          Row variant=message-heading
            Icon name=Sparkles size=18
            Text variant=author "My AI"
            Text variant=muted "$workingLabel"
          Text variant=markdown "$partial"
      If condition=$hasSources
        Card variant=sources
          Heading level=3 "Sources"
          For each=$sources
            Link href=$item.url "$item.title"
      For each=$deployments
        Card variant=sources
          Heading level=3 "$item.title"
          Text variant=muted "$item.statusLabel"
          Text "$item.detail"
          If condition=$item.canOpen
            Link href=$item.url "$item.linkLabel"
          If condition=$item.hasHosting
            Link href=$item.hostingURL "Open My Hosting"
      If condition=$hasEvents
        Card variant=activity
          Heading level=3 "Activity"
          For each=$events
            Card variant=event
              Text variant=event-title "$item.method"
              Text variant=pre "$item.content"
      If condition=$connectionStatus
        Text variant=status "$connectionStatus"
      For each=$approvals
        Card variant=approval
          Row
            Icon name=ShieldQuestionMark size=22
            Heading level=3 "$item.title"
          Text variant=pre "$item.content"
          If condition=$item.isConnection
            Link href=$item.connectURL "$item.connectLabel"
          Row
            Button action=approve item=$item.id variant=primary disabled=$item.submitting label=$item.approveLabel
            Button action=deny item=$item.id disabled=$item.submitting label=$item.denyLabel
    Stack variant=composer-wrap
      If condition=$message
        Alert "$message"
      If condition=$hasAttachments
        Row variant=attachments
          For each=$attachments
            Button action=remove-attachment item=$item.id icon=FileText label=$item.name variant=subtle
      Card variant=composer
        If condition=$isCodeMode
          Row variant=composer-project
            Button action=projects icon=FolderOpen variant=project-picker disabled=$busy label=$projectLabel
            Button action=create-project icon=FolderPlus variant=subtle disabled=$busy "New project"
        Input name=prompt type=textarea placeholder=$placeholder variant=prompt
        Row variant=composer-controls
          Button action=tools icon=Wrench label="Tools & skills" variant=icon disabled=$busy
          Button action=attach icon=Plus label="Attach text or code" variant=icon disabled=$busy
          Button action=policy icon=ShieldCheck variant=permission disabled=$busy "$policyLabel"
          Spacer
          Select name=provider options=$providerOptions disabled=$busy
          Select name=model options=$modelOptions disabled=$busy
          If condition=$localModelSelected
            Button action=model-settings item=$selectedLocalModel icon=SlidersHorizontal label="Model settings" variant=icon disabled=$busy
          If condition=$codeMode
            Button action=effort icon=Gauge variant=effort "$effortLabel"
          If condition=$busy
            Button action=stop icon=Square label="Stop" variant=send
          Else
            Button action=send icon=ArrowUp label="Send message" variant=send disabled=$cannotSend
        If condition=$effortOpen
          Card variant=effort-popover
            Row
              Icon name=Zap size=18
              Text variant=author "Reasoning effort"
            For each=$efforts
              Button action=set-effort item=$item.value label=$item.label variant=$item.variant
      Row variant=composer-caption
        Text "$providerNotice"
        Spacer
        Text "Ctrl + Enter to send"
  If condition=$modal
    Card variant=modal
      Row variant=modal-heading
        Heading level=2 "$modalTitle"
        Spacer
        Button action=close icon=X label="Close dialog" variant=icon
      If condition=$message
        Alert "$message"
      If condition=$settingsView
        Text "API keys are protected by Windows on this host. They are never saved in conversations or returned by the server."
        Text variant=field-label "OpenAI API key"
        Input name=openaiKey type=password placeholder="Enter OpenAI API key"
        Button action=save-openai variant=primary "Save OpenAI connection"
        Text variant=field-label "DeepSeek API key"
        Input name=deepseekKey type=password placeholder="Enter DeepSeek API key"
        Button action=save-deepseek variant=primary "Save DeepSeek connection"
        Divider
        Text "$storageDetail"
        Text "Custom endpoints, cloud budgets and voice/image attachments are unavailable in this preview."
      If condition=$modelSettingsView
        Text variant=author "$tuneModel"
        Text variant=muted "Saved for this model and your account. Changes apply to new requests in Chat and Code."
        If condition=$tuneLoading
          Text variant=status "Loading your model settings..."
        If condition=$tuneLoadFailed
          Button action=model-settings item=$tuneModel "Retry loading settings"
        If condition=$tuneLoaded
          Card variant=sources
            Text variant=author "Context on this server"
            Text "$tuneContextSummary"
            Text variant=muted "$tuneContextBasis"
            Text variant=muted "$tuneContextNotice"
          Row variant=model-settings-actions
            Button action=llm-low-memory disabled=$tuneBusy "Low-memory preset"
            Button action=llm-defaults disabled=$tuneBusy "Use defaults"
          Text variant=muted "Leave context fields blank for automatic model and hardware sizing. Uploaded files stay private; My AI reads relevant sections when needed."
          Grid variant=model-settings-fields
            For each=$tuneBasicFields
              Stack variant=model-setting-field
                Text variant=field-label "$item.label"
                Input name=$item.name label=$item.label type=number min=$item.min max=$item.max step=$item.step placeholder="Automatic" disabled=$tuneBusy
                Text variant=muted "$item.help"
          Stack variant=model-setting-field
            Text variant=field-label "Chat behaviour"
            Select name=llm_chatMode options=$tuneChatModes disabled=$tuneBusy label="Chat behaviour"
            Text variant=muted "Plain chat skips web research and app tools for a simpler prompt. Code still uses its required project tools."
          Card variant=disclosure
            Heading level=3 "Advanced settings"
            Grid variant=model-settings-fields
              For each=$tuneAdvancedFields
                Stack variant=model-setting-field
                  Text variant=field-label "$item.label"
                  Input name=$item.name label=$item.label type=number min=$item.min max=$item.max step=$item.step placeholder="Automatic" disabled=$tuneBusy
                  Text variant=muted "$item.help"
            Stack variant=model-setting-field
              Text variant=field-label "Keep model in memory"
              Select name=llm_keepAlive options=$tuneMemoryOptions label="Keep model in memory" disabled=$tuneBusy
              Text variant=muted "Unloading frees memory after the reply but makes the next request slower."
          Text variant=muted "Context must fit the model and your hardware. Long conversations and app workflows may need more room. Internal research keeps deterministic sampling and a stricter reply limit."
          Row variant=model-settings-footer
            Button action=llm-save variant=primary disabled=$tuneBusy "Save model settings"
            Button action=models disabled=$tuneBusy "Back to models"
      If condition=$modelDownloadView
        Text "Download $confirmedPullTag into this server’s shared Ollama library?"
        Text "The download continues when you leave My AI and becomes available to every user on this server. Check the model licence, disk and memory requirements first."
        Row gap=sm
          Button action=models "Back to models"
          Button action=confirm-pull variant=primary "Confirm download"
      If condition=$benchmarkView
        Text "Find a model that can finish your tasks while One Workspace stays responsive. The server owner starts tests; everyone can view the latest result."
        Alert "$benchmarkStatus"
        Text variant=muted "$benchmarkNotice"
        Text "$benchmarkProfile"
        Text "$benchmarkReserve"
        Text "$benchmarkBaseline"
        If condition=$isOwner
          Stack
            If condition=$benchmarkRunning
              Button action=benchmark-stop "Stop test"
            Else
              Select name=benchmarkProfile options=$benchmarkProfiles label="Next test depth"
              Card variant=disclosure
                Heading level=3 "Optional test settings"
                Input name=benchmarkModels label="Specific models, optional" placeholder="Automatic: suitable installed local models"
                Text variant=muted "Leave blank for automatic selection. Advanced users can enter up to8 installed tags separated by commas. Download new models in Models before starting."
                Input name=benchmarkReserve type=number min=4 max=1024 label="Extra RAM reserve in GB, optional" placeholder="Automatic: at least4GB and25% of RAM"
                Text variant=muted "The measured free memory already reflects running Workspace apps. The reserve adds spare room for Windows, incoming requests and other work. Increasing it makes the test more conservative."
              Button action=benchmark-start variant=primary "Start resource-safe test"
        Else
          Text "Ask the server owner to start a test."
        Alert "$benchmarkRecommendation"
        For each=$benchmarkModels
          Card variant=model-card
            Stack gap=sm
              Text variant=author "$item.title"
              Text "$item.score"
              Text variant=muted "$item.detail"
              Text "$item.reason"
              Text variant=muted "$item.resourceLabel"
        If condition=$benchmarkHasResults
          Button action=benchmark-export "Download full evidence"
        Button action=models "Back to models"
        Text variant=muted "Results apply to the tested context and workload. A quick scan is preliminary. No benchmark can reserve resources against every future workload; rerun after changing hardware, active apps or model settings."
      If condition=$modelsView
        Card variant=sources
          Heading level=3 "Find the best model for this PC"
          Text "Compare task reliability while keeping resources available for One Workspace. Tests run on this server and continue when you leave the page."
          Button action=benchmark icon=Gauge "Test this PC"
        Row
          Text "Models run on the machine hosting My AI."
          Spacer
          Button action=refresh icon=RefreshCw label="Refresh models" variant=icon
        Input name=modelSearch placeholder="Filter model names"
        For each=$modelGroups
          Card variant=provider-group
            Button action=toggle-provider item=$item.id icon=$item.icon expanded=$item.expanded label=$item.label variant=provider-toggle
            If condition=$item.expanded
              Text variant=status "$item.status"
              Stack variant=model-list
                For each=$item.models
                  Card variant=model-card
                    Row
                      Icon name=Cpu size=22
                      Stack
                        Text variant=author "$item.name"
                        Text variant=muted "$item.detail"
                      Spacer
                      Button action=use-model item=$item.key "Use"
                      If condition=$item.local
                        Button action=model-settings item=$item.id icon=SlidersHorizontal label="Model settings" variant=icon
                      If condition=$item.canRemove
                        Button action=delete-model item=$item.id icon=Trash2 label="Remove model" variant=icon
        Card variant=disclosure
          Heading level=3 "Add a local model"
          Text variant=muted "Choose a model from the Ollama library, then enter its tag."
          Link href="https://ollama.com/library" "Browse model library ↗"
          If condition=$isOwner
            Input name=pullModel placeholder="Model tag, e.g. qwen3:0.6b"
            Button action=pull variant=primary "Download model"
          Else
            Text variant=muted "Ask the server owner to download a model."
          Text variant=muted "Check the model’s licence and hardware requirements first. Downloads continue when you leave this page."
        If condition=$hasActiveDownloads
          Heading level=3 "Active downloads"
          For each=$activeDownloads
            Card variant=download-row
              Row variant=download-heading
                Text variant=author "$item.model"
                Text variant=download-state "$item.state"
              If condition=$item.isActive
                Metric value=$item.completed max=$item.total label=$item.label
                Text variant=muted "$item.bytes"
              Text variant=status "$item.detail"
              Row variant=download-actions
                If condition=$item.canCancel
                  Button action=cancel-pull item=$item.id "Cancel download"
                If condition=$item.canRetry
                  Button action=retry-pull item=$item.model "Retry download"
                If condition=$item.canRemove
                  Button action=remove-download item=$item.id "Remove entry"
        Card variant=disclosure
          Heading level=3 "$downloadHistoryLabel"
          Text variant=muted "Shared server history. Removing an entry keeps model files intact."
          For each=$historyDownloads
            Card variant=download-row
              Row variant=download-heading
                Text variant=author "$item.model"
                Text variant=download-state "$item.state"
              If condition=$item.isActive
                Metric value=$item.completed max=$item.total label=$item.label
                Text variant=muted "$item.bytes"
              Text variant=status "$item.detail"
              Row variant=download-actions
                If condition=$item.canCancel
                  Button action=cancel-pull item=$item.id "Cancel download"
                If condition=$item.canRetry
                  Button action=retry-pull item=$item.model "Retry download"
                If condition=$item.canRemove
                  Button action=remove-download item=$item.id "Remove entry"
        If condition=$ollamaUpgradeBusy
          Alert "$ollamaUpgradeStatus"
        Card variant=disclosure
          Heading level=3 "Server & maintenance"
          For each=$providerStatuses
            Text variant=status "$item.label"
          Text variant=status "$ollamaUpgradeStatus"
          If condition=$isOwner
            Text variant=muted "Upgrade using the official Windows installer. Local AI may pause; your model library stays in place."
            Button action=upgrade-ollama disabled=$ollamaUpgradeBusy "Upgrade Ollama"
          Else
            Text variant=muted "If a model requires newer Ollama, ask the server owner to upgrade it from this panel."
          Link href="https://ollama.com/download/windows" "Ollama for Windows ↗"
          Text variant=muted "Models and downloads are shared on this server. Ollama manages their storage location."
      If condition=$toolsView
        Heading level=3 "Your Workspace apps"
        Text "$workspaceNotice"
        For each=$workspaceApps
          Card variant=tool-card
            Text variant=author "$item.name"
            Text variant=muted "$item.description"
            Text variant=status "$item.capabilityLabel"
            Link href=$item.url "Open app ↗"
        Heading level=3 "Web search"
        Text "$searchProvider"
        Text "Ask normally. My AI searches public information when needed. Private app content stays out of public web searches."
        Link href=$searchSource "SearXNG source and licences ↗"
        Text "$toolNotice"
        Text "Chat has live time, calculator, public web search/page reading, and private conversation/attachment reads. You can read your own projects. Automatic tool use depends on the selected model; explicit commands work with any chat model."
        For each=$toolCommands
          Button action=tool-command item=$item.value label=$item.value variant=menu
        For each=$toolList
          Card variant=tool-card
            Text variant=author "$item.name"
            Text variant=muted "$item.description"
        Text "Ask normally. My AI searches the web when current information is needed and shows its sources. You can ask it to search, or say “don’t search the web” to keep the conversation offline. Attachment contents are never added to automatic search queries."
        Text "Codex uses the same private SearXNG search through My AI’s included tools. Project editing stays inside the selected project and saves to your private Git repository."
      If condition=$projectsView
        Text "Choose a project for this conversation, or use General to get started."
        Button action=general-project icon=Folder variant=primary disabled=$projectBusy "Use General project"
        Text "Give your project a name. We'll create its folder in My Drive and a private repository in Git. My AI saves completed changes to both automatically."
        Input name=projectName placeholder="Project name"
        Button action=add-project icon=FolderPlus variant=primary disabled=$projectBusy "$createProjectLabel"
        For each=$projects
          Card variant=project-card
            Row
              Icon name=FolderCode size=22
              Text variant=author "$item.name"
            Text variant=muted "$item.location"
            Text variant=status "$item.status"
            If condition=$item.hasLinks
              Row variant=project-links
                Link href=$item.driveUrl "Open in My Drive"
                Link href=$item.url "View in Git"
            Row variant=project-actions
              Button action=choose-project item=$item.id disabled=$item.disabledOpen variant=primary "Open project"
              If condition=$item.managed
                Button action=save-project item=$item.id disabled=$projectBusy "$item.saveLabel"
      If condition=$sessionView
        Input name=title placeholder="Conversation title"
        Button action=rename "Rename"
        Button action=pin "$pinLabel"
        Button action=archive "$archiveLabel"
        Button action=fork "Fork conversation"
        Button action=export-json "Export JSON"
        Button action=export-markdown "Export Markdown"
        Button action=import "Import JSON conversation"
        Button action=retry disabled=$busy "Retry last prompt"
        Button action=delete variant=danger "Move to private trash"
      If condition=$diffView
        Text "Review the files changed in your project. Completed AI changes are saved to Git automatically."
        Text variant=pre "$gitStatus"
        Text variant=diff "$gitDiff"
      If condition=$accountView
        Text variant=author "$accountName"
        Text "$accountDetail"
        Text "Your projects and conversations stay connected to your account."
        Button action=logout "Sign out"
